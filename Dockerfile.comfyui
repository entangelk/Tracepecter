# ComfyUI GPU 서비스 — P01-04 생성 파이프라인용(소유자 Windows 설치 대체 구동 경로).
# WSL에서 Windows python을 직접 기동하면 OPENSSL_Applink 로 죽는 환경 제약 때문에
# 컨테이너로 구동한다. 모델은 기존 F:\AI\ComfyUI-models 를 마운트해 재사용.
# 버전은 소유자 Windows 설치와 동일 계열(v0.38.0 이후 main)로 clone 한다.
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://github.com/comfyanonymous/ComfyUI /tmp/comfyui-clone \
    && cd /tmp/comfyui-clone \
    && git fetch --depth 1 origin fa98a189b4271c76f66210e15f81790b555eb610 \
    && git checkout fa98a189b4271c76f66210e15f81790b555eb610 \
    && mkdir /ComfyUI && cp -r /tmp/comfyui-clone/* /ComfyUI/ \
    && rm -rf /tmp/comfyui-clone

WORKDIR /ComfyUI
# pytorch 베이스 이미지의 CUDA torch 를 요구사항이 이미 충족하므로 재설치하지 않는다.
RUN pip install --no-cache-dir -r requirements.txt

# Qwen-Image 2.1 viggle-turbo 커스텀 노드(Viggle 공식 — 소유자 F:\AI 설치본과 동일 파일)
COPY docker/viggle_turbo.py custom_nodes/viggle_turbo.py

EXPOSE 8188
CMD ["python", "main.py", "--listen", "0.0.0.0", "--port", "8188", "--output-directory", "/output"]
