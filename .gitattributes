# Preserve the metadata bytes bound to existing experiment artifacts.
data/metadata.csv text eol=crlf
# Keep P08 measurement inputs identical across working trees and Git blobs.
experiments/p08_anonymized/measure/*.csv text eol=lf
experiments/p08_anonymized/face_boxes.csv text eol=lf
experiments/p08_anonymized/diagnostic/*.csv text eol=lf
# Preserve the raw prediction bytes bound to P09 calibration verification.
experiments/p09_leakage_repair/r1/calibration/*.csv -text whitespace=cr-at-eol
# Raw third-party log tables include intentional padding.
experiments/p09_leakage_repair/r1/calibration/calibration.log -text -whitespace
# Preserve the manual review bytes frozen by the owner-review lock.
experiments/p09_leakage_repair/r1/diagnostic/visual_review_new.csv -text whitespace=cr-at-eol
